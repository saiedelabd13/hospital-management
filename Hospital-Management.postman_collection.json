{
  "info": {
    "name": "🏥 Hospital Management System",
    "description": "نظام إدارة المستشفى الشامل - Postman Collection\n\n**تعليمات الاستخدام:**\n1. شغّل المشروع: `mvn spring-boot:run`\n2. استورد الملف ده في Postman\n3. ابدأ بـ Login عشان تاخد الـ Token\n4. الـ Token بيتحط تلقائياً في كل الـ Requests\n\n**Base URL:** http://localhost:8080/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "departmentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "recordId",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    pm.test('✅ Login successful', () => pm.response.to.have.status(200));",
                  "    pm.test('✅ Token received', () => pm.expect(res.token).to.not.be.empty);",
                  "    console.log('Token saved:', res.token);",
                  "} else {",
                  "    pm.test('❌ Login failed', () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "تسجيل الدخول كمدير النظام - يحفظ الـ Token تلقائياً"
          }
        },
